# DocRAG 后端环境变量示例（复制为 .env 后按需修改）
# 所有变量以 RAG_ 前缀注入（见 app/config.py）

# ---- 存储 ----
RAG_DATA_DIR=./data
RAG_DB_PATH=./app.db
RAG_MODEL_DIR=./models

# ---- 嵌入（bge-m3）----
# EMBED_BACKEND=bge-m3 时使用真实模型；EMBED_MOCK=true 强制走确定性 mock（离线/CI）
RAG_EMBED_BACKEND=bge-m3
RAG_EMBED_MOCK=false
RAG_EMBED_DIM=1024

# ---- 重排（bge-reranker-v2-m3）----
RAG_RERANK_BACKEND=bge-reranker-v2-m3
RAG_RERANK_MOCK=false

# ---- 解析（docling）----
RAG_PARSE_BACKEND=docling
RAG_PARSE_MOCK=false

# ---- LLM 双后端 ----
# LLM_BACKEND=ollama | openai | mock
RAG_LLM_BACKEND=ollama
RAG_LLM_MOCK=false
RAG_OLLAMA_BASE_URL=http://localhost:11434/v1
RAG_OPENAI_BASE_URL=
RAG_OPENAI_API_KEY=
RAG_LLM_MODEL=llama3.1:8b

# ---- 检索参数 ----
RAG_RRF_K=60
RAG_RETRIEVE_TOP_K=20
RAG_FAISS_TOP_K=20
RAG_FTS_TOP_K=20
RAG_RERANK_TOP_K=5

# ---- 服务 ----
RAG_PORT=8000

# ---- 身份与访问控制（ACL）----
# 仅当 RAG_TRUSTED_PROXY=true 时，后端才从反向代理注入的请求头解析身份：
#   X-Rag-Tenant / X-Rag-User / X-Rag-Group（逗号分隔）
# 关闭（默认）时一律使用本地默认身份（"default" 租户）。
# 安全要求：开启时必须由 nginx 等可信反向代理注入这些头（见部署文档），
# 且 CORS allow_headers 不含 X-Rag-*，浏览器无法伪造身份。
RAG_TRUSTED_PROXY=false
